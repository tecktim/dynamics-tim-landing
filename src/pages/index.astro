  <script
    type="application/json"
    id="quiz-case-studies"
    set:html={JSON.stringify(
      Object.fromEntries(engagementModels.map((model) => [model.id, model.caseStudy]))
    )
      .replace(/</g, "\\u003c")
      .replace(/>/g, "\\u003e")
      .replace(/&/g, "\\u0026")}
  />
  <script>
    (function () {
      const totalSteps = 3;
      const answers: Record<string, string> = {};
      const answerLabels: Record<string, string> = {};
      const questionLabels: Record<string, string> = {
        "1": "Release-Reife",
        "2": "Wissensverteilung",
        "3": "Fehlersichtbarkeit",
      };
      const caseStudies: Record<string, { industry: string; text: string }> = JSON.parse(
        document.getElementById("quiz-case-studies")?.textContent ?? "{}"
      );
      const caseStudyLookup = new Map(Object.entries(caseStudies));
      const bookingUrl =
        "https://outlook.office.com/bookwithme/user/c7bd6282644a4fcb82fd8cc491a921e5@dynamics-tim.dev?anonymous&ismsaljsauthenabled&ep=plink";
      const btns = document.querySelectorAll<HTMLButtonElement>(".quiz-btn");
      const steps = Array.from(document.querySelectorAll<HTMLElement>(".quiz-step"));
      const resultEl = document.getElementById("quiz-result");
      const resultText = document.getElementById("quiz-result-text");
      const resultLink = document.getElementById("quiz-result-link") as HTMLAnchorElement | null;
      const resultCal = document.getElementById("quiz-result-cal") as HTMLAnchorElement | null;
      const resultFinding = document.getElementById("quiz-result-finding");
      const resultRisk = document.getElementById("quiz-result-risk");
      const resultDerivation = document.getElementById("quiz-result-derivation");
      const resultBadge = document.getElementById("quiz-result-badge");
      const resultTitle = document.getElementById("quiz-result-title");
      const resultTagline = document.getElementById("quiz-result-tagline");
      const resultProof = document.getElementById("quiz-result-proof");
      const resultProofLabel = document.getElementById("quiz-result-proof-label");
      const stepLabel = document.getElementById("quiz-step-label");
      const progressBar = document.getElementById("quiz-progress-bar") as HTMLElement | null;
      const stepsWrapper = document.getElementById("quiz-steps");
      const answerSummary = document.getElementById("quiz-answer-summary");
      const resetTop = document.getElementById("quiz-reset-top") as HTMLButtonElement | null;
      const editBtn = document.getElementById("quiz-edit") as HTMLButtonElement | null;

      const scoreMatrix: Record<string, Record<string, number>> = {
        automated: { embedded: 1, fullpackage: 1 },
        days: { audit: 1, embedded: 2, fullpackage: 2 },
        weeks: { audit: 2, embedded: 1, fullpackage: 2 },
        direct: { audit: 3, embedded: 1, fullpackage: 2 },
        documented: { embedded: 1, fullpackage: 1 },
        oneperson: { audit: 1, embedded: 2, fullpackage: 2 },
        nobody: { audit: 3, embedded: 1, fullpackage: 2 },
        alerting: { embedded: 1, fullpackage: 1 },
        users: { audit: 1, embedded: 2, fullpackage: 1 },
        no: { audit: 3, embedded: 1, fullpackage: 2 },
      };

      function buildFindingText() {
        const q1 = answers["1"];
        const q2 = answers["2"];
        const q3 = answers["3"];

        const releaseSignals: Record<string, string> = {
          automated: "Euer Release-Prozess läuft bereits weit automatisiert.",
          days: "Euer Release braucht noch manuelle Schritte und kostet ein bis zwei Tage.",
          weeks: "Euer Release ist über eine Woche lang und damit deutlich länger als nötig.",
          direct: "Bei euch ist jedes Deployment ein Einzelfall. Das ist kein Prozessproblem, sondern ein Personenrisiko.",
        };

        const knowledgeSignals: Record<string, string> = {
          documented: "Das Wissen über Plugins und Flows ist dokumentiert und im Team nachvollziehbar.",
          oneperson: "Nur eine Person kennt die einzelnen Plugins und Flows wirklich.",
          nobody: "Niemand kann die Historie und Abhängigkeiten vollständig erklären — das System ist historisch gewachsen.",
        };

        const alertSignals: Record<string, string> = {
          alerting: "Bei einem Fehler läuft Monitoring und Alerting bereits.",
          users: "Wenn etwas fehlschlägt, fällt es eher beim Anwender auf als im Team.",
          no: "Bei einem Nachtfehler merkt niemand frühzeitig etwas.",
        };

        return [releaseSignals[q1], knowledgeSignals[q2], alertSignals[q3]].join(" ");
      }

      function buildRiskText() {
        const q1 = answers["1"];
        const q2 = answers["2"];
        const q3 = answers["3"];

        const risks: string[] = [];

        if (q1 === "direct") {
          risks.push("Jede Änderung in Prod ist potenziell riskant, weil es keinen standardisierten Releasepfad gibt.");
        } else if (q1 === "weeks") {
          risks.push("Der Release-Prozess ist langsam genug, dass kleine Probleme zu größeren Störungen und Regressionsrisiken werden.");
        } else if (q1 === "days") {
          risks.push("Manuelle Schritte ziehen Fehler und Verzögerungen nach sich, die bei jedem Release wieder auftauchen.");
        }

        if (q2 === "nobody") {
          risks.push("Wenn die Person wegfällt, die die Logik kennt, seid ihr blind und müsst im Notfall improvisieren.");
        } else if (q2 === "oneperson") {
          risks.push("Die Wissenslast sitzt in einer einzigen Person — ein typischer Bottleneck bei kritischen Plugins und Flows.");
        }

        if (q3 === "no") {
          risks.push("Fehler werden erst nach außen sichtbar, wenn der Kunde oder die User sie erleben.");
        } else if (q3 === "users") {
          risks.push("Das Monitoring ist nicht früh genug, damit das Team aktiv reagieren kann.");
        }

        return risks.join(" ");
      }

      function buildDerivationText() {
        const q1 = answers["1"];
        const q2 = answers["2"];
        const q3 = answers["3"];

        if (q1 === "direct" && q2 === "nobody") {
          return "Weil ihr direkt in Prod ändert und das Wissen nur in Einzelpersonen steckt, ist der Engpass die fehlende Standardisierung und Dokumentation — nicht der technische Funktionsumfang.";
        }

        if (q1 === "weeks" && q2 === "oneperson" && q3 === "users") {
          return "Weil ihr Releases verzögert, das Wissen auf eine Person fällt und Fehler spät sichtbar werden, ist der Engpass ein nicht tragfähiger operativer Rhythmus.";
        }

        if (q1 === "days" && q2 === "documented" && q3 === "alerting") {
          return "Weil ihr schon gut dokumentiert seid und überwacht werdet, braucht ihr keinen reinen Audit-Block, sondern eine gezielte Umsetzungskraft im Team.";
        }

        return "Weil ihr diese Signale gemeinsam zeigt, liegt der Engpass nicht im Projektstart, sondern im operativen Reifegrad der Plattform.";
      }

      function getRecommendation() {
        const q1 = answers["1"];
        const q2 = answers["2"];
        const q3 = answers["3"];

        if (q1 === "automated" && q2 === "documented" && q3 === "alerting") {
          return {
            id: "disqualify",
            title: "Ehrliche Antwort: dafür brauchst du mich nicht.",
            badge: "",
            tagline: "Euer Setup ist sauberer als das der meisten Teams.",
            finding: "Euer Release-Prozess ist automatisiert, das Wissen ist dokumentiert und eure Fehlererkennung läuft bereits mit Monitoring und Alerting.",
            risk: "Die größten Risiken liegen nicht im System, sondern in der Richtung: Ein Mandat wäre hier überdimensioniert und würde das Team nicht wirklich voranbringen.",
            derivation: "Weil ihr genau die Kriterien für eine reife Setup-Umgebung erfüllt, ist ein Mandat für eure aktuelle Situation nicht der passende Einstieg.",
            text: "Wenn ihr eine zweite Meinung zu einer konkreten Architekturentscheidung wollt, meldet euch gern — aber ein Mandat wäre Overkill.",
            href: "mailto:hello@dynamics-tim.dev?subject=Zweite%20Meinung%20zu%20Dynamics%20365&body=Hallo%20Tim%2C%20ich%20h%C3%A4tte%20gerne%20eine%20zweite%20Meinung%20zu%20einer%20konkreten%20Architekturentscheidung.%20",
            ctaLabel: "Mail senden →",
            proofLabel: "Beleg aus dem Praxisbereich",
            proofText:
              "Ich arbeite mit Teams, die schon sauber am Laufen sind und dann gezielt an Architektur, ALM und Skalierung arbeiten — nicht mit Re-Engineering aus einer Notlage heraus.",
            linkText: "Mehr zu meinem Ansatz →",
            linkHref: "#engagement-modelle",
            calHref: "mailto:hello@dynamics-tim.dev?subject=Zweite%20Meinung%20zu%20Dynamics%20365",
          };
        }

        const weightedScores: Record<string, number> = { audit: 0, embedded: 0, fullpackage: 0 };
        const valuesToScore = [q1, q2, q3];

        valuesToScore.forEach((value) => {
          const score = scoreMatrix[value] ?? {};
          Object.entries(score).forEach(([key, weight]) => {
            weightedScores[key] = (weightedScores[key] ?? 0) + weight;
          });
        });

        const recommendationOrder: Array<keyof typeof weightedScores> = [
          "audit",
          "fullpackage",
          "embedded",
        ];
        const recommendedKey = [...recommendationOrder].sort(
          (a, b) => weightedScores[b] - weightedScores[a]
        )[0];
        const match = {
          audit: {
            id: "audit",
            title: "Audit & Strategie",
            badge: "Schnelleinstieg · 1–2 Wochen",
            tagline: "Du bekommst Klarheit — nicht nur Folien.",
            text: "Ich prüfe eure Architektur, Release- und Sicherheitsroutinen und lege einen priorisierten Maßnahmenplan mit Quick Wins und Roadmap fest.",
            href: "#audit",
            ctaLabel: "30-Min Slot buchen →",
            calHref: bookingUrl,
            linkText: "Mehr zum Modell →",
            linkHref: "#audit",
          },
          embedded: {
            id: "embedded",
            title: "Embedded Developer",
            badge: "Laufend · Sprint-basiert",
            tagline: "Senior-Kraft ins Team — ohne Overhead.",
            text: "Du bekommst Senior-Kapazität im Sprint-Prozess — von Plugins über Automationen bis hin zu QA und stabilen Release-Zyklen.",
            href: "#embedded",
            ctaLabel: "30-Min Slot buchen →",
            calHref: bookingUrl,
            linkText: "Mehr zum Modell →",
            linkHref: "#embedded",
          },
          fullpackage: {
            id: "fullpackage",
            title: "Full Package: Audit → Enablement",
            badge: "End-to-End · 3–4 Monate",
            tagline: "Einmal richtig machen. Dauerhaft wirken.",
            text: "Vom Audit über Umsetzung bis zur Team-Übergabe — damit euer Team langfristig stabil und eigenständig releasen kann.",
            href: "#fullpackage",
            ctaLabel: "30-Min Slot buchen →",
            calHref: bookingUrl,
            linkText: "Mehr zum Modell →",
            linkHref: "#fullpackage",
          },
        };

        const baseMatch = match[recommendedKey] ?? match.audit;
        const caseStudy = caseStudyLookup.get(baseMatch.id) ?? {
          industry: "Dynamics 365",
          text: "Dein Setup braucht eine klare Priorisierung, damit Technologie und Team wieder in einen stabilen Rhythmus kommen.",
        };
        const caseStudyText = caseStudy.text || "Dein Setup braucht eine klare Priorisierung, damit Technologie und Team wieder in einen stabilen Rhythmus kommen.";

        return {
          ...baseMatch,
          finding: buildFindingText(),
          risk: buildRiskText(),
          derivation: buildDerivationText(),
          proofLabel: `Projekt-Spotlight: ${caseStudy.industry}`,
          proofText: caseStudyText,
        };
      }

      function answeredCount() {
        return Object.keys(answers).length;
      }

      function setActiveStep(step: number) {
        steps.forEach((stepEl) => {
          const isActive = Number(stepEl.dataset.step) === step;
          stepEl.classList.toggle("hidden", !isActive);
          stepEl.setAttribute("aria-hidden", isActive ? "false" : "true");
        });
      }

      function updateProgress() {
        const done = answeredCount();
        if (stepLabel) {
          stepLabel.textContent =
            done === totalSteps ? "Auswertung bereit" : `Frage ${done + 1} von ${totalSteps}`;
        }
        if (progressBar) {
          progressBar.style.width = `${(done / totalSteps) * 100}%`;
        }
        if (resetTop) {
          resetTop.classList.toggle("hidden", done === 0);
        }
      }

      function renderAnswerSummary() {
        if (!answerSummary) return;
        answerSummary.innerHTML = "";
        ["1", "2", "3"].forEach((question) => {
          const item = document.createElement("li");
          item.className = "rounded-xl border border-surface-200 bg-surface-50 px-3 py-2";
          item.textContent = `${questionLabels[question]}: ${answerLabels[question] ?? "n/a"}`;
          answerSummary.appendChild(item);
        });
      }

      function clearResultView() {
        if (!resultEl) return;
        resultEl.classList.add("hidden");
        if (stepsWrapper) {
          stepsWrapper.classList.remove("hidden");
        }
      }

      function revealResult() {
        if (!resultEl || !resultText) return;
        const rec = getRecommendation();
        if (resultText) resultText.textContent = rec.text;
        if (resultTitle) resultTitle.textContent = rec.title;
        if (resultBadge) {
          resultBadge.textContent = rec.badge || "";
          resultBadge.classList.toggle("hidden", !rec.badge);
        }
        if (resultTagline) resultTagline.textContent = rec.tagline ? `"${rec.tagline}"` : "";
        if (resultFinding) resultFinding.textContent = rec.finding ?? "";
        if (resultRisk) resultRisk.textContent = rec.risk ?? "";
        if (resultDerivation) resultDerivation.textContent = rec.derivation ?? "";
        if (resultProof) resultProof.textContent = rec.proofText ?? "";
        if (resultProofLabel) resultProofLabel.textContent = rec.proofLabel ?? "";
        if (resultLink) {
          resultLink.href = rec.linkHref ?? rec.href ?? "#engagement-modelle";
          resultLink.textContent = rec.linkText ?? "Mehr zum Modell →";
        }
        if (resultCal) {
          resultCal.href = rec.calHref ?? bookingUrl;
          resultCal.textContent = rec.ctaLabel ?? "30-Min Slot buchen →";
          if (rec.calHref?.startsWith("mailto:")) {
            resultCal.removeAttribute("target");
            resultCal.removeAttribute("rel");
          } else {
            resultCal.target = "_blank";
            resultCal.rel = "noopener noreferrer";
          }
        }
        renderAnswerSummary();
        resultEl.classList.remove("hidden");
        if (stepsWrapper) {
          stepsWrapper.classList.add("hidden");
        }
        if (stepLabel) {
          stepLabel.textContent = "Empfehlung";
        }
        resultTitle?.focus();
        if (progressBar) {
          progressBar.style.width = "100%";
        }
        const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const card = resultEl.querySelector(".quiz-result-card") as HTMLElement | null;
        if (card && !reducedMotion) {
          card.style.opacity = "0";
          card.style.transform = "translateY(20px)";
          requestAnimationFrame(() => {
            requestAnimationFrame(() => {
              card.style.transition =
                "opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1), transform 0.5s cubic-bezier(0.16, 1, 0.3, 1)";
              card.style.opacity = "1";
              card.style.transform = "translateY(0)";
            });
          });
        }
        resultEl.scrollIntoView({ behavior: reducedMotion ? "auto" : "smooth", block: "nearest" });
      }

      function updateSelectedState(question: string, activeButton: HTMLButtonElement) {
        document
          .querySelectorAll<HTMLButtonElement>(`.quiz-btn[data-q="${question}"]`)
          .forEach((btn) => {
            const isActive = btn === activeButton;
            btn.classList.toggle("border-brand-400", isActive);
            btn.classList.toggle("bg-brand-50", isActive);
            btn.classList.toggle("text-brand-700", isActive);
            btn.classList.toggle("shadow-sm", isActive);
            btn.setAttribute("aria-pressed", isActive ? "true" : "false");
          });
      }

      function resetQuiz() {
        Object.keys(answers).forEach((key) => {
          delete answers[key];
        });
        Object.keys(answerLabels).forEach((key) => {
          delete answerLabels[key];
        });
        btns.forEach((btn) => {
          btn.classList.remove("border-brand-400", "bg-brand-50", "text-brand-700", "shadow-sm");
          btn.setAttribute("aria-pressed", "false");
        });
        clearResultView();
        setActiveStep(1);
        updateProgress();
      }

      btns.forEach((btn) => {
        btn.addEventListener("click", () => {
          const q = btn.dataset.q!;
          const v = btn.dataset.v!;
          answers[q] = v;
          answerLabels[q] = btn.textContent?.trim() ?? "";
          updateSelectedState(q, btn);
          updateProgress();
          if (answeredCount() === totalSteps) {
            revealResult();
          } else {
            clearResultView();
            setActiveStep(Math.min(Number(q) + 1, totalSteps));
          }
        });
      });

      if (resetTop) {
        resetTop.addEventListener("click", () => {
          resetQuiz();
        });
      }

      if (editBtn) {
        editBtn.addEventListener("click", () => {
          resetQuiz();
          const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
          document.getElementById("quiz-container")?.scrollIntoView({
            behavior: reducedMotion ? "auto" : "smooth",
            block: "nearest",
          });
        });
      }

      setActiveStep(1);
      updateProgress();
    })();
  </script>

