              Hol dir meinen <strong>10-Punkte Dynamics 365 Quick-Check</strong> — kostenlos per Mail.
            </p>
          </div>
        </div>
        <div class="flex items-center gap-3 shrink-0">
          <a
            href="mailto:hello@dynamics-tim.dev?subject=Quick-Check%20anfragen&body=Hallo%20Tim%2C%20ich%20m%C3%B6chte%20den%20kostenlosen%20Dynamics%20365%20Quick-Check%20erhalten."
            class="rounded-xl bg-brand-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500"
          >
            Quick-Check anfordern
          </a>
          <button
            id="quick-audit-close"
            class="rounded-lg p-1.5 text-slate-400 transition hover:bg-brand-100 hover:text-slate-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500"
            aria-label="Schließen"
          >
            <svg viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5" aria-hidden="true">
              <path
                d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z"
              ></path>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>

  <script>
    (function () {
      const banner = document.getElementById("quick-audit-banner");
      const closeBtn = document.getElementById("quick-audit-close");
      if (!banner || !closeBtn) return;

      const STORAGE_KEY = "qa-banner-dismissed";
      const QUIZ_COMPLETED_KEY = "quiz-completed";
      let shown = false;

      function showBanner() {
        if (
          shown ||
          sessionStorage.getItem(STORAGE_KEY) ||
          sessionStorage.getItem(QUIZ_COMPLETED_KEY) ||
          !banner
        )
          return;
        shown = true;
        banner.classList.remove("hidden");
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            banner!.classList.remove("translate-y-full");
          });
        });
      }

      function hideBanner() {
        if (!banner) return;
        banner.classList.add("translate-y-full");
        setTimeout(() => banner!.classList.add("hidden"), 500);
        sessionStorage.setItem(STORAGE_KEY, "1");
      }

      closeBtn.addEventListener("click", hideBanner);
      window.addEventListener("quiz-complete", hideBanner);

      // Trigger on 60% scroll depth
      function onScroll() {
        const scrolled = window.scrollY + window.innerHeight;
        const total = document.documentElement.scrollHeight;
        if (scrolled / total >= 0.6) {
          showBanner();
          window.removeEventListener("scroll", onScroll);
        }
      }
      window.addEventListener("scroll", onScroll, { passive: true });

      // Also trigger on mouseleave (desktop exit intent)
      document.documentElement.addEventListener("mouseleave", (e) => {
        if ((e as MouseEvent).clientY <= 0) showBanner();
      });

      // Quick-Check form submission
      const auditForm = document.getElementById("quick-audit-form") as HTMLFormElement | null;
      const auditEmail = document.getElementById("quick-audit-email") as HTMLInputElement | null;
      const auditSuccess = document.getElementById("quick-audit-success");
      const auditError = document.getElementById("quick-audit-error");

      if (auditForm && auditEmail) {
        auditForm.addEventListener("submit", async (e) => {
          e.preventDefault();
          const email = auditEmail.value.trim();
          if (!email || !auditEmail.checkValidity()) {
            auditEmail.focus();
            return;
          }

          const submitBtn = auditForm.querySelector('button[type="submit"]') as HTMLButtonElement;
          if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.textContent = "Sende\u2026";
          }

          try {
            const res = await fetch("https://n8n.dynamics-tim.dev/webhook/quick-check", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({
                email,
                source: window.location.href,
                timestamp: new Date().toISOString(),
              }),
            });

            if (res.ok) {
              if (auditSuccess) auditSuccess.classList.remove("hidden");
              if (auditError) auditError.classList.add("hidden");
              auditEmail.value = "";
              auditEmail.disabled = true;
              if (submitBtn) submitBtn.style.display = "none";
              setTimeout(() => hideBanner(), 3000);
            } else {
              throw new Error("Request failed");
            }
          } catch {
            if (auditError) auditError.classList.remove("hidden");
            if (auditSuccess) auditSuccess.classList.add("hidden");
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.textContent = "Quick-Check anfordern";
            }
          }
        });
      }
    })();
  </script>

