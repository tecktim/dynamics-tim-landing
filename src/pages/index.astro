---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import { site } from '../data/site';

const base = import.meta.env.BASE_URL ?? '/';
const to = (path: string) => {
  const trimmed = path.replace(/^\//, '');
  const [pathname, hash] = trimmed.split('#');
  const normalized = pathname ? `${pathname.replace(/\/$/, '')}/` : '';
  const suffix = hash ? `#${hash}` : '';
  return `${base}${normalized}${suffix}`;
};

const engagementModels = [
  {
    id: 'audit',
    badge: 'Schnelleinstieg · 1–2 Wochen',
    title: 'Audit & Strategie',
    tagline: 'Du bekommst Klarheit — nicht nur Folien.',
    description:
      'Ich analysiere deine aktuelle Dynamics 365 Landschaft: Architektur, Security, Prozesse und ALM. Am Ende steht ein priorisierter Aktionsplan mit Quick Wins, Risiken und Roadmap.',
    features: [
      'Architektur- & Security-Analyse',
      'ALM- und DevOps-Bewertung',
      'Priorisierter Maßnahmenplan',
      'Aufwandsschätzung für nächste Schritte',
    ],
    details: [
      'Security Model Audits: Business Units, Rollen, Field Security und DLP',
      'Performance Tuning für Model-driven Apps, Plugins und Datenabfragen',
      'ALM-Standards für mehrere Umgebungen und release-sichere Deployments',
    ],
    caseStudy: {
      industry: 'IT-Dienstleister',
      text: 'Für einen IT-Dienstleister habe ich in 10 Tagen eine undokumentierte Plugin-Architektur mit 40+ Custom-Steps analysiert und kritische Sicherheitslücken im Rollenmodell aufgedeckt — Ergebnis: konsolidierter Maßnahmenplan, der 3 Monate Fehlerbehebung eingespart hat.',
    },
    href: to('contact'),
    cta: 'Audit anfragen',
  },
  {
    id: 'embedded',
    badge: 'Laufend · Sprint-basiert',
    title: 'Embedded Developer',
    tagline: 'Senior-Kraft ins Team — ohne Overhead.',
    description:
      'Ich integriere mich direkt in euren SCRUM oder Kanban-Prozess und liefere Features, Plugins, Integrationen und Tests im Sprint-Rhythmus. Mit Pair-Programming und Code-Reviews hebe ich gleichzeitig das Niveau des Teams.',
    features: [
      'C# Plugins, PCF Controls & Power Automate',
      'Azure Functions & Service Bus Integrationen',
      'Playwright UI-Tests & Quality Gates',
      'Pair-Programming & Code-Reviews',
    ],
    details: [
      'Dynamics 365 Sales/Service Integrationen mit ERP, BI und Microsoft 365',
      'Power Automate Orchestrierung mit sauberem Fehlerhandling und Monitoring',
      'Azure Functions, Service Bus und Event Grid für event-driven Workflows',
    ],
    caseStudy: {
      industry: 'Maschinenbauunternehmen',
      text: 'Für ein Maschinenbauunternehmen habe ich als Embedded Developer über 6 Monate eine komplexe ERP-Dynamics-Integration mit Azure Service Bus und automatisierten UI-Tests aufgebaut — Ergebnis: stabile Release-Zyklen alle 2 Wochen ohne manuelle Regressionstests.',
    },
    href: to('contact'),
    cta: 'Verfügbarkeit anfragen',
  },
  {
    id: 'fullpackage',
    badge: 'End-to-End · 3–4 Monate',
    title: 'Full Package: Audit → Enablement',
    tagline: 'Einmal richtig machen. Dauerhaft wirken.',
    description:
      'Vom Audit über Konzeption und Umsetzung bis zur Team-Übergabe. Ich verantworte den gesamten Zyklus und stelle sicher, dass dein Team am Ende eigenständig releasen kann.',
    features: [
      'Vollständiger Audit & Zielbild',
      'Iterative Umsetzung mit DevOps',
      'Dokumentation & Übergabe-Sprint',
      'Team-Enablement & Coaching',
    ],
    details: [
      'Dataverse, Model-driven Apps, Custom Pages und Canvas Apps',
      'CI/CD mit Azure DevOps oder GitHub Actions inklusive Quality Gates',
      'Monitoring über Application Insights, Log Analytics und Alerts',
    ],
    caseStudy: {
      industry: 'Handelsunternehmen',
      text: 'Für ein Handelsunternehmen habe ich von Audit bis Übergabe ein komplettes Dynamics 365 Sales-Rollout durchgeführt — Ergebnis: das interne Team konnte nach 12 Wochen eigenständig neue Features deployen, ohne externen Support.',
    },
    href: to('contact'),
    cta: 'Gesamtpaket anfragen',
  },
];

const valueBullets = [
  {
    title: 'Embedded ins Team',
    description:
      'Ich verstärke dein bestehendes Team mit Senior-Level Expertise in Dynamics 365 Development und Consulting.',
  },
  {
    title: 'Full-Stack Power Platform',
    description:
      'Canvas Apps, React/TypeScript-PCFs, C# Plugins und Automatisierung aus einer Hand.',
  },
  {
    title: 'Release-Sicherheit inklusive',
    description:
      'Azure DevOps, Code-Quality-Gates und Monitoring sorgen für planbare Deployments ohne Überraschungen.',
  },
];

const approachSteps = [
  {
    phase: '01',
    duration: 'Woche 1–2',
    title: 'Audit',
    tagline: 'Ich bringe die Wahrheit ans Licht — auch die unbequeme.',
    description:
      'Ist-Analyse von Architektur, Security Model, Datenflüssen und ALM-Setup. Am Ende weißt du genau, wo die größten Risiken und schnellsten Wins liegen — nicht was du hören willst, sondern was du brauchst.',
  },
  {
    phase: '02',
    duration: 'Woche 2–3',
    title: 'Konzeption',
    tagline: 'Kein Slide-Deck. Ein echter Plan.',
    description:
      'Technisches Zielbild, priorisiertes Backlog und messbare Erfolgskennzahlen. Stakeholder werden früh eingebunden — damit Überraschungen in der Umsetzung die Ausnahme sind, nicht die Regel.',
  },
  {
    phase: '03',
    duration: 'Woche 3–10',
    title: 'Umsetzung',
    tagline: 'Keine Big-Bang-Releases. Kleine Increments, jedes getestet.',
    description:
      'Iterative Implementierung mit Plugins, Automationen, Integrationen — und Tests für alles Business-kritische. DevOps und Quality Gates laufen von Anfang an mit, nicht am Ende.',
  },
  {
    phase: '04',
    duration: 'Woche 9–12',
    title: 'Enablement',
    tagline: 'Ich gehe. Dein Team bleibt handlungsfähig.',
    description:
      'Dokumentation, Pairing-Sessions und Übergabe. Dein Team kann stabil releasen und die Lösung eigenständig weiterentwickeln — ohne mich rufen zu müssen.',
  },
];

const faqs = [
  {
    question: 'Was kostet die Zusammenarbeit?',
    answerHtml:
      'Ich arbeite auf Tagessatz-Basis. Je nach Scope und Engagement-Modell liegt ein typisches Projekt zwischen 5 und 25 Tagen. Im kostenlosen Erstgespräch klären wir den genauen Rahmen und ich erstelle dir eine transparente Aufwandsschätzung — ohne Überraschungen.',
    plainAnswer:
      'Ich arbeite auf Tagessatz-Basis. Je nach Scope und Engagement-Modell liegt ein typisches Projekt zwischen 5 und 25 Tagen. Im kostenlosen Erstgespräch klären wir den genauen Rahmen und ich erstelle dir eine transparente Aufwandsschätzung — ohne Überraschungen.',
  },
  {
    question: 'Wie starte ich ein Dynamics 365 Projekt mit dir als Freelancer?',
    answerHtml:
      'Wir beginnen mit einem fokussierten Erstgespräch, in dem wir die wichtigsten Dynamics 365 Use Cases priorisieren und das weitere Vorgehen klären. Über das <a href="mailto:hello@dynamics-tim.dev" class="text-brand-500 underline decoration-2 decoration-brand-200 hover:text-brand-400">Kontaktformular</a> oder per Mail erhältst du in 48 Stunden eine Roadmap inklusive Aufwandsschätzung.',
    plainAnswer:
      'Wir starten mit einem Erstgespräch, in dem wir die wichtigsten Dynamics 365 Use Cases priorisieren und das weitere Vorgehen klären. Über das Kontaktformular oder per Mail erhältst du in 48 Stunden eine Roadmap inklusive Aufwandsschätzung.',
  },
  {
    question: 'Unterstützt du auch bestehende Dynamics 365 Teams langfristig?',
    answerHtml: `Ja. Ich coache interne Entwickler:innen, führe gemeinsame Code-Reviews durch und implementiere Quality Gates sowie Automatisierung. Über den <a href="${to('profile')}" class="text-brand-500 underline decoration-2 decoration-brand-200 hover:text-brand-400">Profil-Bereich</a> findest du Referenzen und konkrete Technologien, die ich einbringe.`,
    plainAnswer:
      'Ich unterstütze bestehende Dynamics 365 Teams mit Coaching, Code-Reviews, Quality Gates und Automatisierung. Referenzen und Technologien findest du im Profil-Bereich.',
  },
  {
    question: 'Welche Dynamics 365 und Power Platform Technologien nutzt du?',
    answerHtml: `Ich arbeite mit C# Plugins, Power Automate, PCF Controls, Azure Functions, Service Bus, Event Grid und Playwright für UI Test Automation. Diese Technologien ermöglichen es mir, skalierbare und effiziente Lösungen zu entwickeln, die den spezifischen Anforderungen von Dynamics 365 gerecht werden.`,
    plainAnswer:
      'Ich arbeite mit C# Plugins, Power Automate, PCF Controls, Azure Functions, Service Bus, Event Grid und Playwright für UI Test Automation. Diese Technologien ermöglichen es mir, skalierbare und effiziente Lösungen zu entwickeln, die den spezifischen Anforderungen von Dynamics 365 gerecht werden.',
  },
  {
    question: 'Wie stellst du Security und Performance in Dynamics 365 sicher?',
    answerHtml:
      'Ich prüfe Security Model, Rollen, Field Security und DLP-Regeln und optimiere Plugins, Abfragen und Client-Skripte. Dazu kommen Monitoring, Audit-Logs und klare Performance-Guidelines.',
    plainAnswer:
      'Ich prüfe Security Model, Rollen, Field Security und DLP-Regeln und optimiere Plugins, Abfragen und Client-Skripte. Dazu kommen Monitoring, Audit-Logs und klare Performance-Guidelines.',
  },
  {
    question: 'Welche Deliverables bekomme ich nach dem Projektstart?',
    answerHtml:
      'Du erhältst ein priorisiertes Backlog, ein technisches Zielbild, Empfehlungen für ALM/CI-CD sowie eine Roadmap für die nächsten Sprints. Bei Bedarf ergänze ich eine Referenzarchitektur und ein Enablement-Konzept.',
    plainAnswer:
      'Du erhältst ein priorisiertes Backlog, ein technisches Zielbild, Empfehlungen für ALM/CI-CD sowie eine Roadmap für die nächsten Sprints. Bei Bedarf ergänze ich eine Referenzarchitektur und ein Enablement-Konzept.',
  },
];

const canonicalUrl = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).toString()
  : Astro.url.href;
const siteUrl = Astro.site ? Astro.site.toString() : new URL('/', canonicalUrl).toString();
const providerId = `${siteUrl}#person`;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.plainAnswer,
    },
  })),
};

const serviceItemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Dynamics 365 & Power Platform Services',
  itemListElement: engagementModels.map((service, index) => {
    const serviceUrl = new URL(service.href ?? '/', siteUrl).toString();
    return {
      '@type': 'ListItem',
      position: index + 1,
      item: {
        '@type': 'Service',
        name: service.title,
        description: service.description,
        url: serviceUrl,
        provider: {
          '@type': 'Person',
          '@id': providerId,
        },
        areaServed: {
          '@type': 'Country',
          name: 'Deutschland',
        },
      },
    };
  }),
};

const structuredData = [faqSchema, serviceItemList];
---

<BaseLayout
  title="Dynamics 365 Developer & Technical Consultant"
  description="Dynamics 365 Freelancer für Service- & Sales-Prozesse: Power Platform Engineering, Azure Integrationen, DevOps & Enablement."
  breadcrumbs={[{ name: "Startseite", url: "/" }]}
>
  <Hero />

  {/* Problem → Lösung → Ergebnis strip */}
  <section class="bg-white py-16 border-b border-surface-100 animate-on-scroll">
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid gap-8 md:grid-cols-3">
        <div
          class="rounded-2xl border border-red-100 bg-red-50/60 p-6 space-y-3"
          data-reveal
          data-reveal-delay="0"
        >
          <div
            class="inline-flex items-center gap-2 rounded-full bg-red-100 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-red-700"
          >
            Euer Status Quo
          </div>
          <ul class="space-y-2 text-sm text-slate-700">
            <li class="flex items-start gap-2">
              <span class="mt-0.5 text-red-400">✗</span> Fragile Plugins, die bei jedem Update brechen
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-0.5 text-red-400">✗</span> Manuelle Prozesse, die niemand gerne macht
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-0.5 text-red-400">✗</span> Releases, die alle nervös machen
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-0.5 text-red-400">✗</span> Kein Team, das die Lösung eigenständig pflegen
              kann
            </li>
          </ul>
        </div>
        <div
          class="rounded-2xl border border-brand-100 bg-brand-50/60 p-6 space-y-3"
          data-reveal
          data-reveal-delay="80"
        >
          <div
            class="inline-flex items-center gap-2 rounded-full bg-brand-100 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-brand-700"
          >
            Was ich ändere
          </div>
          <ul class="space-y-2 text-sm text-slate-700">
            <li class="flex items-start gap-2">
              <span class="mt-0.5 text-brand-400">→</span> Saubere Plugin-Architektur mit Testabdeckung
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-0.5 text-brand-400">→</span> Automatisierte Workflows mit robustem Fehlerhandling
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-0.5 text-brand-400">→</span> CI/CD-Pipelines mit Quality Gates
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-0.5 text-brand-400">→</span> Enablement, das Wissen im Team hält
            </li>
          </ul>
        </div>
        <div
          class="rounded-2xl border border-green-100 bg-green-50/60 p-6 space-y-3"
          data-reveal
          data-reveal-delay="160"
        >
          <div
            class="inline-flex items-center gap-2 rounded-full bg-green-100 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-green-700"
          >
            Euer Ergebnis
          </div>
          <ul class="space-y-2 text-sm text-slate-700">
            <li class="flex items-start gap-2">
              <span class="mt-0.5 text-green-500">✓</span> Schnellere Release-Zyklen ohne Überraschungen
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-0.5 text-green-500">✓</span> Confidence bei jedem Deployment
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-0.5 text-green-500">✓</span> Ein Team, das selbstständig weiterentwickelt
            </li>
            <li class="flex items-start gap-2">
              <span class="mt-0.5 text-green-500">✓</span> CRM, das Vertrieb und Service wirklich nutzen
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface-100 py-20 animate-on-scroll">
    <div class="mx-auto max-w-6xl px-6">
      <h2 class="section-title" data-reveal data-reveal-delay="0">Warum Tim?</h2>
      <div class="mt-10 grid gap-6 md:grid-cols-3" data-reveal data-reveal-delay="80">
        {
          valueBullets.map((bullet, index) => (
            <div class="card" data-reveal data-reveal-delay={`${index * 80 + 160}`}>
              <h3 class="text-xl font-semibold text-slate-900">{bullet.title}</h3>
              <p class="mt-3 text-base text-slate-600">{bullet.description}</p>
            </div>
          ))
        }
      </div>
      <div
        class="mt-12 rounded-2xl border border-red-100 bg-red-50/40 p-6 md:p-8"
        data-reveal
        data-reveal-delay="400"
      >
        <h3 class="text-lg font-semibold text-slate-900 mb-4">
          Was ich <span class="text-red-600">NICHT</span> mache
        </h3>
        <div class="grid gap-4 md:grid-cols-3">
          <div class="flex items-start gap-3">
            <span
              class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-red-100 text-red-500 text-sm font-bold"
              >✗</span
            >
            <p class="text-sm text-slate-600">
              <strong class="text-slate-800">Kein 50-Personen-Rollout.</strong> Ich bin Freelancer, kein
              Systemhaus. Mein Sweet Spot: gezielte Verstärkung für Teams von 2–15.
            </p>
          </div>
          <div class="flex items-start gap-3">
            <span
              class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-red-100 text-red-500 text-sm font-bold"
              >✗</span
            >
            <p class="text-sm text-slate-600">
              <strong class="text-slate-800">Keine Slide-Decks ohne Code.</strong> Ich liefere funktionierende
              Lösungen, nicht Management-Präsentationen die in der Schublade landen.
            </p>
          </div>
          <div class="flex items-start gap-3">
            <span
              class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-red-100 text-red-500 text-sm font-bold"
              >✗</span
            >
            <p class="text-sm text-slate-600">
              <strong class="text-slate-800">Kein Offshore-Team.</strong> Du arbeitest direkt mit mir
              — DACH-Zeitzonen, deutsche Kommunikation, persönliche Verantwortung.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface-100 py-20 animate-on-scroll" id="engagement-modelle">
    <div class="mx-auto max-w-6xl px-6">
      <div class="mb-10 max-w-3xl space-y-4">
        <h2 class="section-title" data-reveal data-reveal-delay="0">So arbeiten wir zusammen</h2>
        <p class="text-lg text-slate-600" data-reveal data-reveal-delay="80">
          Drei Wege, wie ich dein Projekt voranbringen kann — je nachdem, wo du gerade stehst.
        </p>
      </div>
      <div class="grid gap-6 lg:grid-cols-3">
        {
          engagementModels.map((model, index) => (
            <article
              id={model.id}
              class="card flex flex-col gap-5 border-surface-200 bg-white/90"
              data-reveal
              data-reveal-delay={`${index * 100 + 160}`}
            >
              <div>
                <span class="inline-flex items-center rounded-full bg-brand-50 px-3 py-1 text-xs font-semibold text-brand-700 ring-1 ring-brand-200/60">
                  {model.badge}
                </span>
              </div>
              <div>
                <h3 class="text-2xl font-semibold text-slate-900">{model.title}</h3>
                <p class="mt-1 text-sm font-medium text-brand-600 italic">"{model.tagline}"</p>
              </div>
              <p class="text-base text-slate-600">{model.description}</p>
              <ul class="space-y-1.5">
                {model.features.map((feature) => (
                  <li class="flex items-center gap-2 text-sm text-slate-700">
                    <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-brand-100 text-brand-600">
                      <svg
                        viewBox="0 0 20 20"
                        fill="currentColor"
                        class="h-3 w-3"
                        aria-hidden="true"
                      >
                        <path
                          fill-rule="evenodd"
                          d="M16.707 5.293a1 1 0 0 1 0 1.414l-7.25 7.25a1 1 0 0 1-1.414 0l-3.5-3.5a1 1 0 1 1 1.414-1.414l2.793 2.793 6.543-6.543a1 1 0 0 1 1.414 0z"
                          clip-rule="evenodd"
                        />
                      </svg>
                    </span>
                    {feature}
                  </li>
                ))}
              </ul>
              {model.details && model.details.length > 0 && (
                <details class="group/det rounded-xl border border-surface-200 bg-surface-50 text-sm">
                  <summary class="flex cursor-pointer items-center justify-between gap-2 p-4 text-xs font-semibold uppercase tracking-wide text-slate-500 hover:text-brand-600 transition-colors">
                    <span>Use Cases &amp; Tech Details</span>
                    <span
                      class="text-brand-400 transition-transform group-open/det:rotate-180"
                      aria-hidden="true"
                    >
                      ▾
                    </span>
                  </summary>
                  <ul class="px-4 pb-4 space-y-1.5">
                    {model.details.map((detail: string) => (
                      <li class="flex items-start gap-2 text-slate-600">
                        <span class="mt-1 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-brand-100 text-brand-600">
                          <svg
                            viewBox="0 0 20 20"
                            fill="currentColor"
                            class="h-2.5 w-2.5"
                            aria-hidden="true"
                          >
                            <path
                              fill-rule="evenodd"
                              d="M16.707 5.293a1 1 0 0 1 0 1.414l-7.25 7.25a1 1 0 0 1-1.414 0l-3.5-3.5a1 1 0 1 1 1.414-1.414l2.793 2.793 6.543-6.543a1 1 0 0 1 1.414 0z"
                              clip-rule="evenodd"
                            />
                          </svg>
                        </span>
                        {detail}
                      </li>
                    ))}
                  </ul>
                </details>
              )}
              <details class="group/spot rounded-xl border border-surface-200 bg-surface-50 text-sm">
                <summary class="flex cursor-pointer items-center justify-between gap-2 p-4 text-xs font-semibold uppercase tracking-wide text-slate-500 hover:text-brand-600 transition-colors">
                  <span>Projekt-Spotlight: {model.caseStudy.industry}</span>
                  <span
                    class="text-brand-400 transition-transform group-open/spot:rotate-180"
                    aria-hidden="true"
                  >
                    ▾
                  </span>
                </summary>
                <div class="px-4 pb-4">
                  <p class="text-slate-600 leading-relaxed">{model.caseStudy.text}</p>
                </div>
              </details>
              <a
                href={model.href}
                class="mt-auto inline-flex items-center gap-1 text-sm font-semibold text-brand-500 transition hover:text-brand-400"
              >
                <span>{model.cta}</span>
                <span aria-hidden="true">&rarr;</span>
              </a>
            </article>
          ))
        }
      </div>

      {/* 3-Question Selector Quiz */}
      <div
        class="mt-14 rounded-2xl border border-brand-100 bg-gradient-to-b from-brand-50/80 to-white p-8"
        data-reveal
        data-reveal-delay="460"
        id="engagement-quiz"
      >
        <div class="grid gap-5 md:grid-cols-[minmax(0,1fr)_auto] md:items-start">
          <div class="max-w-2xl">
            <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-brand-700">
              Nicht sicher, was du brauchst?
            </p>
            <h3 class="text-2xl font-semibold text-slate-900">
              Beantworte 3 Fragen und erhalte eine passende Empfehlung.
            </h3>
            <p class="mt-2 text-sm text-slate-600">
              Dauer: unter 60 Sekunden. Du kannst deine Antworten jederzeit anpassen.
            </p>
          </div>
          <div
            class="rounded-xl border border-brand-100 bg-white/90 px-4 py-3 text-xs text-slate-600"
          >
            <p class="font-semibold uppercase tracking-wide text-brand-700">Schnellcheck</p>
            <p class="mt-1">Direkt umsetzbare Empfehlung statt allgemeiner Sales-Floskeln.</p>
          </div>
        </div>

        <div class="mt-7 space-y-5" id="quiz-container">
          <div class="rounded-2xl border border-surface-200 bg-white p-5">
            <div class="mb-3 flex items-center justify-between gap-3">
              <p id="quiz-step-label" class="text-sm font-semibold text-slate-800">Frage 1 von 3</p>
              <button
